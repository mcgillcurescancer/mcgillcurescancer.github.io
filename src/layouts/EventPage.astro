---
/*
  Shared shell for our two flagship events. Both pages open the same way, so
  the shape lives here and each page supplies only its own content:

  1. The first card .... name, tagline, the page's own buttons and facts, the
                         two figures a sponsor asks about, and a pile of three
                         gold polaroids — then whatever the page puts in the
                         `highlights` slot, on the same paper
  2. The default slot .. page-specific cards
*/
import Layout from './Layout.astro';
import Doodle from '../components/Doodle.astro';
import Polaroid from '../components/Polaroid.astro';

interface Props {
  title: string;
  description: string;
  tagline: string;
  /**
   * Three photos of the event for the pile in the first card, each with the
   * handwritten line under it. The first one is also the social-share image.
   */
  photos: { src: ImageMetadata; alt: string; caption: string }[];
  expectedTurnout: string;
  fundraisingGoal: string;
  /**
   * The event's own mark, beside its name — a path under `public/`, cut out
   * to the drawing like the one on its capstone card. Left off, the heading
   * stands on its own.
   */
  logo?: string;
}

const {
  title, description, tagline, photos,
  expectedTurnout, fundraisingGoal, logo,
} = Astro.props;

/*
  Scatter for the three frames. A frame is 1.165x as tall as it is wide, so at
  55% of the box width it stands 0.64 widths tall, and the `aspect-[4/5]` box
  is 1.25 widths. Each frame overlaps its neighbour only across the photo, so
  every caption stays readable.
*/
const positions = [
  'left-0 top-0 z-30 rotate-[-4deg]',
  'right-0 top-[22%] z-20 rotate-[3deg]',
  'left-[8%] bottom-0 z-10 rotate-[-2deg]',
];
---

<Layout title={`${title} | McGill Cures Cancer`} description={description}
        {...(photos[0] && { image: photos[0].src })}>
  <section class="section-shell pt-10">
    <div class="section-card">
      <div class="grid items-center gap-12 md:grid-cols-[1.15fr_1fr]">
        <div>
          <div class="flex items-center gap-4">
            {/* `alt=""`: the heading beside it already says the name. */}
            {logo && (
              <img src={logo} alt="" width="334" height="256"
                   class="h-16 w-auto flex-none sm:h-20" loading="eager" decoding="async" />
            )}
            {/* No marker swipe on this one: the event titles are long enough
                to wrap, and the swipe is sized for a phrase that stays on one
                line. */}
            <h1 class="min-w-0 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">{title}</h1>
          </div>
          <p class="mt-4 max-w-xl text-lg text-slate-600">{tagline}</p>

          {/* The page's own buttons and key facts. */}
          <slot name="hero" />

          {/* Tinted, so the two figures read as tiles on the white card. The
              coloured left edge is the only thing telling the pair apart at a
              glance. */}
          <dl class="mt-8 grid grid-cols-2 gap-4">
            <div class="rounded-2xl border border-stone-200 border-l-4 border-l-doodle-yellow bg-stone-50/70 p-4 sm:p-5">
              <dt class="text-sm font-medium text-slate-500">Expected turnout</dt>
              <dd class="mt-1 text-lg font-bold text-slate-900 sm:text-2xl">{expectedTurnout}</dd>
            </div>
            <div class="rounded-2xl border border-stone-200 border-l-4 border-l-doodle-red bg-stone-50/70 p-4 sm:p-5">
              <dt class="text-sm font-medium text-slate-500">Fundraising goal</dt>
              <dd class="mt-1 text-lg font-bold text-mcc-600 sm:text-2xl">{fundraisingGoal}</dd>
            </div>
          </dl>
        </div>

        {/* On screen as the page opens, so the frames load eagerly. Only the
            first carries alt text; the other two are more of the same day. */}
        <div class="relative mx-auto aspect-[4/5] w-full max-w-md">
          {photos.slice(0, 3).map((photo, i) => (
            <Polaroid
              src={photo.src}
              alt={i === 0 ? photo.alt : ''}
              caption={photo.caption}
              tone="gold"
              loading="eager"
              sizes="(min-width: 768px) 230px, 50vw"
              class:list={['absolute w-[55%]', positions[i]]}
            />
          ))}
        </div>
      </div>

      {/* Page-specific detail that belongs on the same paper as the intro. */}
      <slot name="highlights" />
    </div>
  </section>

  <!-- Pen marks in the gaps between the cards. Decorative only — see
       Doodle.astro. -->
  <Doodle variant="wave" />

  <!-- Page-specific detail goes here — each page supplies its own cards. -->
  <slot />
</Layout>
