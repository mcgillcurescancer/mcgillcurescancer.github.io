---
/*
  Shared shell for our two flagship events. Both pages need the same four
  blocks — outline, expected turnout, structure, fundraising goal — so the
  shape lives here and each page supplies only its own content.
*/
import { Image } from 'astro:assets';
import Layout from './Layout.astro';
import Doodle from '../components/Doodle.astro';

interface Props {
  title: string;
  description: string;
  tagline: string;
  heroImage: ImageMetadata;
  expectedTurnout: string;
  fundraisingGoal: string;
  structure: string[];
  /**
   * The event's own mark, beside its name — a path under `public/`, cut out
   * to the drawing like the one on its capstone card. Left off, the heading
   * stands on its own.
   */
  logo?: string;
}

const {
  title, description, tagline, heroImage,
  expectedTurnout, fundraisingGoal, structure, logo,
} = Astro.props;
---

<Layout title={`${title} | McGill Cures Cancer`} description={description} image={heroImage}>
  <section class="section-shell pt-10">
    <div class="section-card">
      {/* No marker swipe on this one: the event titles are long enough to
          wrap, and the swipe is sized for a phrase that stays on one line. */}
      <div class="flex items-center gap-4">
        {/* `alt=""`: the heading beside it already says the name. */}
        {logo && (
          <img src={logo} alt="" width="334" height="256"
               class="h-16 w-auto flex-none sm:h-20" loading="eager" decoding="async" />
        )}
        <h1 class="min-w-0 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">{title}</h1>
      </div>
      <p class="mt-4 max-w-2xl text-lg text-slate-600">{tagline}</p>
      {/* The first screen's next step — the page supplies its own buttons and
          key facts here, between the tagline and the photo. */}
      <slot name="hero" />
      {/* This is the page's LCP, so it loads eagerly rather than lazily. The
          card caps out at 1088px, so there is nothing to gain above 1200 —
          `width` pins the fallback `src` there too, which otherwise renders at
          the source photo's full intrinsic size. */}
      <Image src={heroImage} alt={title}
             widths={[600, 900, 1200]}
             width={1200}
             sizes="(min-width: 1152px) 1088px, 100vw"
             loading="eager" fetchpriority="high" decoding="async"
             class="mt-10 h-80 w-full rounded-2xl object-cover shadow-sm" />
    </div>
  </section>

  <!-- Pen marks in the gaps between the cards. Decorative only — see
       Doodle.astro. -->
  <Doodle variant="wave" />

  <section class="section-shell">
    <div class="section-card">
      <dl class="grid gap-6 sm:grid-cols-2">
        {/* Tinted, so the two figures still read as tiles now that the card
            behind them is white. The coloured left edge is the only thing
            telling the pair apart at a glance. */}
        <div class="rounded-2xl border border-stone-200 border-l-4 border-l-doodle-yellow bg-stone-50/70 p-6">
          <dt class="text-sm font-medium text-slate-500">Expected turnout</dt>
          <dd class="mt-1 text-2xl font-bold text-slate-900">{expectedTurnout}</dd>
        </div>
        <div class="rounded-2xl border border-stone-200 border-l-4 border-l-doodle-red bg-stone-50/70 p-6">
          <dt class="text-sm font-medium text-slate-500">Fundraising goal</dt>
          <dd class="mt-1 text-2xl font-bold text-mcc-600">{fundraisingGoal}</dd>
        </div>
      </dl>
    </div>
  </section>

  <Doodle variant="loop" />

  <section class="section-shell">
    <div class="section-card">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">
        <span class="hand-underline">Event structure</span>
      </h2>
      <ol class="mt-6 space-y-3">
        {structure.map((item, i) => (
          <li class="flex gap-4">
            <span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-mcc-100 text-sm font-bold text-mcc-700">
              {i + 1}
            </span>
            <p class="text-slate-700">{item}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Doodle variant="triple" />

  <!-- Page-specific detail goes here — each page supplies its own card. -->
  <slot />
</Layout>
