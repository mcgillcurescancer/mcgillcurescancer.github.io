---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Social-share image, root-absolute. Falls back to the club logo. */
  image?: string;
  /**
   * Set on pages that open with a full-bleed hero: the header floats over it
   * transparently and only picks up its background once the hero scrolls away.
   */
  overlayNav?: boolean;
}

const {
  title,
  description,
  image = '/assets/images/logos/mcc/full-mcc.PNG',
  overlayNav = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Display face for headings + handwriting face for polaroid captions. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Outfit:wght@600;700;800&display=swap"
    />

    <!-- Favicons: drop the generated files into public/assets/icons/ -->
    <link rel="icon" type="image/svg+xml" href="/assets/icons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/assets/icons/favicon-96x96.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon.png" />

    <!-- Link previews for Facebook / LinkedIn / iMessage / Slack -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="McGill Cures Cancer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body class="flex min-h-screen flex-col bg-canvas text-slate-800 antialiased">
    <Nav overlay={overlayNav} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Mobile nav toggle. Deliberately hand-rolled: importing all of Flowbite
      // costs ~128KB of JS for this one interaction. If a page later needs a
      // real Flowbite component, import it in that page only.
      const header = document.querySelector<HTMLElement>('[data-site-header]');
      const button = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const menu = document.querySelector<HTMLElement>('#nav-links');

      // Overlay pages ship without `data-solid`; every other page has it baked
      // into the markup, which is also the signal to leave the header alone.
      const isOverlay = header !== null && !header.hasAttribute('data-solid');

      const menuIsOpen = () => button?.getAttribute('aria-expanded') === 'true';

      // Go solid once the hero has scrolled off, and while the mobile menu is
      // open — an open menu over the photo would otherwise have no backdrop.
      const syncHeader = () => {
        if (!isOverlay || !header) return;
        const solid = menuIsOpen() || window.scrollY > window.innerHeight * 0.6;
        header.toggleAttribute('data-solid', solid);
      };

      button?.addEventListener('click', () => {
        const open = menuIsOpen();
        button.setAttribute('aria-expanded', String(!open));
        menu?.classList.toggle('hidden', open);
        syncHeader();
      });

      if (isOverlay) {
        window.addEventListener('scroll', syncHeader, { passive: true });
        window.addEventListener('resize', syncHeader, { passive: true });
        syncHeader();
      }
    </script>
  </body>
</html>
