---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Social-share image, root-absolute. Falls back to the club logo. */
  image?: string;
  /**
   * Set on pages that open with a full-bleed hero: the header floats over it
   * transparently and only picks up its background once the hero scrolls away.
   */
  overlayNav?: boolean;
}

const {
  title,
  description,
  image = '/assets/images/logos/mcc/full-mcc.svg',
  overlayNav = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Display face for headings + handwriting face for polaroid captions. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Outfit:wght@600;700;800&display=swap"
    />

    <!-- Favicons: drop the generated files into public/assets/icons/ -->
    <link rel="icon" type="image/svg+xml" href="/assets/icons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/assets/icons/favicon-96x96.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon.png" />

    <!-- Link previews for Facebook / LinkedIn / iMessage / Slack -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="McGill Cures Cancer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body class="flex min-h-screen flex-col bg-canvas text-slate-800 antialiased">
    <Nav overlay={overlayNav} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Mobile nav toggle. Deliberately hand-rolled: importing all of Flowbite
      // costs ~128KB of JS for this one interaction. If a page later needs a
      // real Flowbite component, import it in that page only.
      const header = document.querySelector<HTMLElement>('[data-site-header]');
      const button = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const menu = document.querySelector<HTMLElement>('#nav-links');
      const toggleLabel = document.querySelector<HTMLElement>('[data-nav-toggle-label]');

      // Overlay pages ship without `data-solid`; every other page has it baked
      // into the markup, which is also the signal to leave the header alone.
      const isOverlay = header !== null && !header.hasAttribute('data-solid');

      const menuIsOpen = () => header?.hasAttribute('data-menu-open') ?? false;

      // Go solid once the hero has scrolled off. Opening the menu no longer
      // forces it: the dropdown is a self-contained card, so the bar can stay
      // transparent and let the card float over the photo.
      const syncHeader = () => {
        if (!isOverlay || !header) return;
        header.toggleAttribute('data-solid', window.scrollY > window.innerHeight * 0.6);
      };

      const setMenu = (open: boolean) => {
        header?.toggleAttribute('data-menu-open', open);
        button?.setAttribute('aria-expanded', String(open));
        if (toggleLabel) {
          toggleLabel.textContent = open ? 'Close main menu' : 'Open main menu';
        }
        syncHeader();
      };

      button?.addEventListener('click', () => setMenu(!menuIsOpen()));

      // In-page anchors do not reload, so without this the panel would sit
      // open over the section the visitor just asked to see.
      menu?.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) setMenu(false);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menuIsOpen()) {
          setMenu(false);
          button?.focus();
        }
      });

      window.addEventListener(
        'resize',
        () => {
          // The panel is mobile-only; left open across the breakpoint it would
          // strand `data-menu-open` on the desktop layout.
          if (window.innerWidth >= 768 && menuIsOpen()) setMenu(false);
          syncHeader();
        },
        { passive: true },
      );

      if (isOverlay) {
        window.addEventListener('scroll', syncHeader, { passive: true });
        syncHeader();
      }
    </script>
  </body>
</html>
