---
/*
  A small set of line icons for the event pages, drawn as pen strokes in
  `currentColor` so the parent sets the ink. Always decorative — each one sits
  beside text that already says what it means — so they are `aria-hidden`.
*/
export type IconName = 'team' | 'sticks' | 'music' | 'cup' | 'trophy' | 'ribbon';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class={className}>
  {name === 'team' && (
    <>
      <circle cx="12" cy="7" r="3" />
      <circle cx="5.5" cy="9" r="2.2" />
      <circle cx="18.5" cy="9" r="2.2" />
      <path d="M6.5 20.5c0-3 2.5-5.5 5.5-5.5s5.5 2.5 5.5 5.5" />
      <path d="M1.5 19c0-2.3 1.5-4.2 3.8-4.5M22.5 19c0-2.3-1.5-4.2-3.8-4.5" />
    </>
  )}
  {name === 'sticks' && (
    <>
      {/* One stick, blade on the ice, and a puck beside it. */}
      <path d="M18.5 2.5 9 17.5H3.5" />
      <ellipse cx="16" cy="18" rx="3" ry="1.2" />
      <path d="M13 18v1.3c0 .7 1.3 1.2 3 1.2s3-.5 3-1.2V18" />
    </>
  )}
  {name === 'music' && (
    <>
      <path d="M9 18V5l11-2v13" />
      <circle cx="6" cy="18" r="3" />
      <circle cx="17" cy="16" r="3" />
    </>
  )}
  {name === 'cup' && (
    <>
      <path d="M4.5 9h12v4.5a6 6 0 0 1-12 0z" />
      <path d="M16.5 10h1.5a2.5 2.5 0 0 1 0 5h-1.8" />
      <path d="M8 2.8c-.9 1 .9 2 0 3.2M12.5 2.8c-.9 1 .9 2 0 3.2" />
    </>
  )}
  {name === 'trophy' && (
    <>
      <path d="M7.5 3.5h9v5.5a4.5 4.5 0 0 1-9 0z" />
      <path d="M7.5 5.5H4.5a3 3 0 0 0 3.4 4.4M16.5 5.5h3a3 3 0 0 1-3.4 4.4" />
      <path d="M12 13.5V17M8.5 20.5h7M9.8 17h4.4" />
    </>
  )}
  {name === 'ribbon' && (
    <>
      <path d="M12 13.6C9.9 11 8.5 8.8 8.5 6.6 8.5 4.5 10 3 12 3s3.5 1.5 3.5 3.6c0 2.2-1.4 4.4-3.5 7z" />
      <path d="M9.6 10.4 5.8 21l3-1 1.1 2.4M14.4 10.4 18.2 21l-3-1-1.1 2.4" />
    </>
  )}
</svg>
