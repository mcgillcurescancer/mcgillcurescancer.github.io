---
// Single source of truth for primary navigation — edit links here and every
// page updates. This is the duplication that hand-written HTML could not avoid.
const links = [
  { href: '/#about', label: 'About' },
  { href: '/events/', label: 'Events' },
  { href: '/#sponsorships', label: 'Sponsorships' },
  { href: '/#contact', label: 'Contact Us' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href.startsWith('/events') && path.startsWith('/events');
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3"
       aria-label="Primary">
    <a href="/" class="flex items-center gap-2 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mcc-600">
      <img src="/assets/images/logos/mcc/mcc-ribbon.PNG" alt="McGill Cure Cancer"
           width="36" height="36" class="h-9 w-auto" />
      <span class="text-base font-semibold tracking-tight">McGill Cure Cancer</span>
    </a>

    <button type="button" data-nav-toggle aria-controls="nav-links"
            aria-expanded="false"
            class="inline-flex items-center rounded-lg p-2 text-slate-600 hover:bg-slate-100 md:hidden">
      <span class="sr-only">Open main menu</span>
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>

    <div id="nav-links" class="hidden w-full md:block md:w-auto">
      <ul class="mt-3 flex flex-col gap-1 md:mt-0 md:flex-row md:items-center md:gap-6">
        {links.map((link) => (
          <li>
            <a href={link.href}
               aria-current={isCurrent(link.href) ? 'page' : undefined}
               class="block rounded px-3 py-2 text-sm font-medium text-slate-700 hover:text-mcc-600 aria-[current=page]:text-mcc-600 md:px-0">
              {link.label}
            </a>
          </li>
        ))}
        <li class="md:ml-2">
          <a href="/#sponsorships"
             class="block rounded-lg bg-mcc-600 px-4 py-2 text-center text-sm font-semibold text-white hover:bg-mcc-700">
            Sponsor Us
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>
