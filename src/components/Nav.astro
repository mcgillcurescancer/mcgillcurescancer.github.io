---
// Single source of truth for primary navigation — edit links here and every
// page updates. This is the duplication that hand-written HTML could not avoid.
const links = [
  { href: '/#about', label: 'About' },
  { href: '/events/', label: 'Events' },
  { href: '/#sponsorships', label: 'Sponsorships' },
  { href: '/#contact', label: 'Contact Us' },
];

interface Props {
  /**
   * Float the header over a full-bleed hero instead of sitting above it. The
   * bar stays transparent until the hero has scrolled past, then fades in.
   */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href.startsWith('/events') && path.startsWith('/events');
---

<!-- `data-solid` drives the opaque look. Pages without an overlay hero get it
     baked in so the header never renders knocked-out white on the cream page;
     overlay pages let the scroll listener in Layout.astro toggle it. -->
<header
  data-site-header
  data-solid={overlay ? undefined : ''}
  class:list={[
    'site-header top-0 z-40',
    overlay ? 'fixed inset-x-0' : 'sticky',
  ]}
>
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3"
       aria-label="Primary">
    <a href="/" class="flex items-center gap-2 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mcc-600">
      <!-- Ribbon and wordmark are split out of the full logo so the ribbon can be
           scaled down to the wordmark's height; the stock lockup has it much taller. -->
      <img src="/assets/images/logos/mcc/mcc-ribbon-mark.svg" alt=""
           width="504" height="820" class="header-logo h-8 w-auto" />
      <img src="/assets/images/logos/mcc/mcc-wordmark.svg" alt="McGill Cures Cancer"
           width="799" height="338" class="header-logo h-8 w-auto" />
    </a>

    <button type="button" data-nav-toggle aria-controls="nav-links"
            aria-expanded="false"
            class="header-link -mr-2 inline-flex items-center justify-center rounded-lg p-2 text-slate-600 md:hidden">
      <span class="sr-only" data-nav-toggle-label>Open main menu</span>
      <!-- Three bars rather than a pair of swapped icons, so the top and bottom
           can rotate into the X while the middle one drops out. -->
      <span class="menu-bars" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

    <!-- One list, two layouts: an inline row from `md` up, and below that a
         card that hangs off `top-full` under the toggle. Taking it out of the
         flex row is what stops opening it from shoving the logo around. -->
    <div id="nav-links"
         class="site-menu absolute top-full right-4 mt-2 w-56 max-h-[calc(100svh-5rem)] overflow-y-auto md:static md:mt-0 md:max-h-none md:w-auto md:overflow-visible">
      <ul class="flex flex-col gap-0.5 p-2 md:flex-row md:items-center md:gap-6 md:p-0">
        {links.map((link) => (
          <li>
            <a href={link.href}
               aria-current={isCurrent(link.href) ? 'page' : undefined}
               class="header-link block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 hover:text-mcc-600 aria-[current=page]:text-mcc-600 md:px-0 md:py-2">
              {link.label}
            </a>
          </li>
        ))}
        <li class="mt-1 md:mt-0 md:ml-2">
          <a href="/#sponsorships"
             class="block rounded-lg bg-mcc-600 px-4 py-2.5 text-center text-sm font-semibold text-white hover:bg-mcc-700 md:py-2">
            Sponsor Us
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<style>
  .site-header {
    /* Shared by the bar and the mobile panel so the two read as one sheet of
       glass rather than two slightly different whites stacked on each other. */
    --header-surface: rgb(255 255 255 / 0.85);
    --header-blur: blur(14px) saturate(140%);
    --header-hairline: #e7e5e4; /* stone-200 */

    border-bottom: 1px solid transparent;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      backdrop-filter 0.3s ease;
  }

  .site-header[data-solid] {
    background-color: var(--header-surface);
    border-bottom-color: var(--header-hairline);
    backdrop-filter: var(--header-blur);
  }

  /* Over the photo the black-and-red lockup vanishes into the image, so knock
     it out to white and lift the links until the bar goes solid. */
  .site-header:not([data-solid]) .header-logo {
    filter: brightness(0) invert(1) drop-shadow(0 1px 2px rgb(0 0 0 / 0.35));
  }

  .site-header:not([data-solid]) .header-link {
    color: #fff;
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.5);
  }

  .site-header:not([data-solid]) .header-link:hover {
    color: var(--color-mcc-100);
  }

  .menu-bars {
    position: relative;
    display: block;
    width: 1.375rem;
    height: 0.875rem;
  }

  .menu-bars > span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 999px;
    background-color: currentColor;
    transition:
      transform 0.28s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.18s ease;
  }

  .menu-bars > span:nth-child(1) { top: 0; }
  .menu-bars > span:nth-child(2) { top: 6px; }
  .menu-bars > span:nth-child(3) { top: 12px; }

  /* Both outer bars travel to the 7px centre line and cross. */
  .site-header[data-menu-open] .menu-bars > span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .site-header[data-menu-open] .menu-bars > span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0.2);
  }

  .site-header[data-menu-open] .menu-bars > span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* The bars are boxes, so the `.header-link` text-shadow does nothing for
     them; they need their own lift to read against the photo. */
  .site-header:not([data-solid]) .menu-bars {
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.45));
  }

  @media (max-width: 767px) {
    .site-menu {
      border-radius: 1rem;
      background-color: var(--header-surface);
      backdrop-filter: var(--header-blur);
      border: 1px solid var(--header-hairline);
      box-shadow: 0 18px 40px -16px rgb(0 0 0 / 0.45);

      /* Faded out rather than `display: none` so it can animate, and scaled
         from the top right so it reads as growing out of the toggle.
         `visibility` keeps it off the tab order while closed. */
      transform-origin: top right;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.375rem) scale(0.96);
      transition:
        opacity 0.18s ease,
        transform 0.18s ease,
        visibility 0s linear 0.18s;
    }

    /* The card is its own light surface, so its links must stay dark even
       while the bar above them is still transparent over the photo. */
    .site-header .site-menu .header-link {
      color: var(--color-slate-700);
      text-shadow: none;
    }

    .site-header[data-menu-open] .site-menu {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity 0.18s ease,
        transform 0.24s cubic-bezier(0.34, 1.28, 0.64, 1),
        visibility 0s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-menu,
    .menu-bars > span {
      transition-duration: 0.01ms;
    }
  }
</style>
