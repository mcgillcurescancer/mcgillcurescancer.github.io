---
// One alternating photos/text row. `flip` swaps the sides so a list of these
// zig-zags down the page, matching the events-page outline.
import Polaroid from './Polaroid.astro';

interface Props {
  title: string;
  blurb: string;
  images: string[];
  /** Handwritten line under each photo, in the same order as `images`. */
  captions?: string[];
  alt: string;
  flip?: boolean;
}
const { title, blurb, images, captions = [], alt, flip = false } = Astro.props;

/*
  Where each polaroid sits inside the stack. The frame is 58% of the stack's
  width and ~76% of its height, so these offsets keep all three inside the
  `aspect-[9/8]` box while still overlapping.
*/
const positions = [
  'left-[1%] top-0 z-30 rotate-[-4deg]',
  'left-[19%] top-[12%] z-20 rotate-[5deg]',
  'left-[35%] top-[24%] z-10 rotate-[-2deg]',
];
---

<section class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 md:grid-cols-2">
  <!-- Overlapping stack of polaroids -->
  <div class:list={['relative aspect-[9/8]', flip && 'md:order-2']}>
    {images.slice(0, 3).map((src, i) => (
      <Polaroid
        src={src}
        alt={i === 0 ? alt : ''}
        caption={captions[i]}
        class:list={[
          'absolute w-[58%] transition-transform duration-200 hover:z-40 hover:scale-[1.04]',
          positions[i],
        ]}
      />
    ))}
  </div>

  <div class:list={[flip && 'md:order-1']}>
    <h3 class="text-2xl font-bold tracking-tight text-slate-900">{title}</h3>
    <p class="mt-4 text-lg text-slate-600">{blurb}</p>
  </div>
</section>
