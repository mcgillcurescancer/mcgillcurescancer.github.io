---
/*
  A capstone event. The two flagship events lead the events page, so they have
  to read as a bigger deal than the showcases below them — but as the same kind
  of thing, pinned to the same board. So this is the showcase row: a pile of
  polaroids beside the write-up, on paper.

  What marks it as a capstone is the gold frames, which is the same signal the
  landing page's clothesline uses — foil for the two flagship events, white for
  everything else. The card's own paper is warmed a shade to match.

  Three frames rather than six, and the captions do a job here: the event's
  name, the fundraising target and the expected turnout, one to a photo. That
  is where the two figures a sponsor asks about live — written under a picture
  in the same hand as every other caption on the site, rather than boxed up in
  tiles of their own.
*/
import Polaroid from './Polaroid.astro';

interface Props {
  title: string;
  blurb: string;
  /** Three photos of the event. Anything past the third is ignored. */
  images: ImageMetadata[];
  alt: string;
  /**
   * The event's name as it is written under the first photo. Defaults to
   * `title`, which is usually too long — the caption strip holds one short
   * line, so give a shorter form here for anything past ~20 characters.
   */
  shortTitle?: string;
  /** e.g. `800 viewers` — written under the third photo. */
  turnout: string;
  /** e.g. `$25,000` — written under the second photo. */
  target: string;
  /** The event's own page. The whole card links here. */
  href: string;
  /** Swaps the pile to the right-hand side, so a pair of these alternates. */
  flip?: boolean;
  /**
   * Set while the event's own page has nothing on it yet: the card drops its
   * link and shows a handwritten note in its place, so nobody is sent through
   * to an empty page.
   */
  comingSoon?: boolean;
}
const {
  title, blurb, images, alt, shortTitle, turnout, target, href,
  flip = false, comingSoon = false,
} = Astro.props;

/*
  One caption per frame, in the order the frames are laid out below. The two
  figures are composed here rather than written into the page's data so they
  stay plain values there — the same numbers the event's own page quotes.
*/
const captions = [`${shortTitle ?? title}`, `${target} target`, `${turnout} expected`];

/*
  Scatter positions for the three polaroids, in the same idiom as the showcase
  rows: three across from `sm` up (frame 37% of the stack width), and a
  staggered column on a phone (58%), where three side by side would leave the
  captions too small to read — and here the captions are the point.

  A frame is 1.165x as tall as it is wide (5.5% border + square photo + 22%
  caption strip), so it stands ~80% of the height of the `aspect-[9/5]` box and
  ~41% of the `aspect-[3/5]` one, which is what the `top` offsets are checked
  against. Either way a frame overlaps its neighbours by roughly the width of
  the white border and no more.
*/
const positions = [
  'w-[58%] left-0      top-0     sm:w-[37%] sm:left-0       sm:top-[4%]  z-30 rotate-[-5deg]',
  'w-[58%] left-[40%]  top-[28%] sm:w-[37%] sm:left-[31.5%] sm:top-[13%] z-20 rotate-[4deg]',
  'w-[58%] left-[4%]   top-[57%] sm:w-[37%] sm:left-[63%]   sm:top-0     z-10 rotate-[-3deg]',
];
---

<section class="section-shell">
  <div
    class:list={[
      'section-card capstone grid items-center gap-10',
      comingSoon && 'capstone-static',
      flip ? 'md:grid-cols-[1fr_2fr]' : 'md:grid-cols-[2fr_1fr]',
    ]}
  >
    <!-- Scattered, lightly overlapping polaroids, on foil -->
    <div class:list={['relative aspect-[3/5] sm:aspect-[9/5]', flip && 'md:order-2']}>
      {images.slice(0, 3).map((src, i) => (
        /* `sizes` describes the photo inside the frame, not the frame: the
           mount eats 11% of the width. Card content is the viewport less the
           shell's 2rem and the card's own padding (3rem a side from `sm`,
           1.5rem below), two thirds of it once the text moves alongside, and a
           frame is 37%/58% of that per the scatter above. */
        <Polaroid
          src={src}
          alt={i === 0 ? alt : ''}
          caption={captions[i]}
          tone="gold"
          sizes="(min-width: 768px) 223px, (min-width: 640px) calc((100vw - 128px) * 0.33), calc((100vw - 80px) * 0.52)"
          class:list={[
            'absolute transition-transform duration-200 hover:z-40 hover:scale-[1.06]',
            positions[i],
          ]}
        />
      ))}
    </div>

    <div class:list={[flip && 'md:order-1']}>
      {/* The one label on the card. Handwritten, with a pen star beside it, so
          "capstone" is said in the margin rather than stamped on a badge. */}
      <p class="capstone-eyebrow">
        <svg class="capstone-star" viewBox="0 0 22 22" aria-hidden="true">
          <path class="star-red"    d="M11 2.5C11.5 8 11.3 14 10.6 19.5" />
          <path class="star-yellow" d="M3 7.6C8 10.1 13.9 11.5 19 12.3" />
          <path class="star-red"    d="M4.4 17C8.9 13.4 13.4 8.6 17.6 5" />
        </svg>
        Capstone event
      </p>

      <h3 class="text-2xl font-bold tracking-tight text-slate-900">{title}</h3>
      <p class="mt-4 text-lg text-slate-600">{blurb}</p>

      {/* The card's one action. Its ::after covers the whole card, so the
          photos are clickable too, and the visible focus ring is drawn on the
          card rather than on the link.

          With no page to send anyone to, the link is gone entirely rather than
          disabled — a note in its place says the detail is still on its way. */}
      {comingSoon ? (
        <p class="capstone-soon">Full details coming soon</p>
      ) : (
        <p class="capstone-more">
          Want to learn more?
          <a href={href} class="capstone-cta">
            Click here
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m0 0-4.2-4.2M15 10l-4.2 4.2"
                 fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                 stroke-linejoin="round" /></svg>
            <span class="sr-only">about {title}</span>
          </a>
        </p>
      )}
    </div>
  </div>
</section>

<style>
  /*
    `.section-card` geometry and shadow, so the capstones line up with the
    showcases below them — but on warmer paper with a gold hairline, a shade
    off white in the same direction as the frames it holds.
  */
  .capstone {
    position: relative;
    border-color: rgb(155 112 18 / 0.22);
    background: #fffdf6;
    transition: box-shadow 200ms ease;
  }

  /* The paper warms under the cursor — the frames have their own lift, so the
     card only has to say it is a target. Nothing to click, so nothing moves. */
  .capstone:hover {
    box-shadow:
      0 1px 2px rgb(28 20 8 / 0.06),
      0 22px 46px -28px rgb(120 82 10 / 0.45);
  }

  .capstone-static:hover {
    box-shadow:
      0 1px 2px rgb(28 20 8 / 0.05),
      0 18px 40px -28px rgb(28 20 8 / 0.35);
  }

  .capstone:has(.capstone-cta:focus-visible) {
    outline: 3px solid #9f1239;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .capstone {
      transition: none;
    }
  }

  .capstone-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.4rem;
    font-family: var(--font-hand);
    font-size: 1.375rem;
    line-height: 1;
    color: #8a6008;
    transform: rotate(-1.5deg);
    transform-origin: left center;
  }

  .capstone-star {
    width: 1.15rem;
    height: 1.15rem;
    overflow: visible;
  }

  .capstone-star path {
    fill: none;
    stroke-width: 1.9;
    stroke-linecap: round;
  }

  .star-red    { stroke: var(--color-doodle-red); }
  .star-yellow { stroke: var(--color-doodle-yellow); }

  /* Sits where the link would, in the same handwriting as the eyebrow — it is
     a note in the margin, not an action. */
  .capstone-soon {
    margin-top: 1.5rem;
    font-family: var(--font-hand);
    font-size: 1.375rem;
    line-height: 1;
    color: #94856b;
    transform: rotate(-1deg);
    transform-origin: left center;
  }

  .capstone-more {
    margin-top: 1.5rem;
    font-size: 1rem;
    color: #57534e;
  }

  .capstone-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: 0.25rem;
    font-weight: 600;
    color: #9f1239;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .capstone-cta svg {
    width: 1.05em;
    height: 1.05em;
    transition: transform 200ms ease;
  }

  .capstone:hover .capstone-cta svg {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .capstone-cta svg {
      transition: none;
    }
  }

  /* Stretched link — the whole card is the target, the text stays selectable. */
  .capstone-cta::after {
    content: '';
    position: absolute;
    inset: 0;
  }
</style>
