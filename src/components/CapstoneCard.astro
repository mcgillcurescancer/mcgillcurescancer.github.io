---
/*
  A capstone event, on foil. The two flagship events lead the events page and
  have to read as a different class of thing from the polaroid showcases below
  them, so this card drops the scrapbook treatment entirely: one large photo,
  the two numbers a sponsor actually asks about, and a way through to the full
  page.

  The gold is the same ink as the gold polaroids on the landing page, pulled
  lighter so a card-sized wash of it still carries dark text at AA.
*/
import { Image } from 'astro:assets';

interface Props {
  title: string;
  blurb: string;
  image: ImageMetadata;
  alt: string;
  /** e.g. `800 viewers` — shown under "Expected turnout". */
  turnout: string;
  /** e.g. `$25,000` — shown under "Fundraising target". */
  target: string;
  /** The event's own page. The whole card links here. */
  href: string;
  /** Swaps the photo to the right-hand side, so a pair of these alternates. */
  flip?: boolean;
}
const { title, blurb, image, alt, turnout, target, href, flip = false } = Astro.props;
---

<article class:list={['capstone', flip && 'capstone-flip']}>
  {/*
    The photo runs edge to edge in its half of the card rather than sitting
    inset with its own radius — at this size a second rounded rectangle
    inside the first only muddies the silhouette. The card clips it, so the
    photo picks up the card's own corners on the outer side.

    The frame exists so the picture can be lifted out of the flow beside the
    text (see the stylesheet) — a square photo in a 36rem column would
    otherwise make the card 36rem tall and leave the text floating in a sea
    of foil.

    Column is half of the 72rem card, so nothing above 600 is ever used on a
    desktop; the extra candidates cover a phone, where it goes full width.
  */}
  <div class="capstone-photo-frame">
    <Image
      src={image}
      alt={alt}
      widths={[480, 720, 960, 1200]}
      sizes="(min-width: 1152px) 576px, (min-width: 768px) 50vw, 100vw"
      loading="lazy"
      decoding="async"
      class="capstone-photo"
    />
  </div>

  <div class="capstone-body">
    <p class="capstone-eyebrow">Capstone event</p>
    <h3 class="capstone-title">{title}</h3>
    <p class="capstone-blurb">{blurb}</p>

    {/* The two figures a sponsor scans for, given the most weight on the
        card after the title. */}
    <dl class="capstone-metrics">
      <div class="capstone-metric">
        <dt>Expected turnout</dt>
        <dd>{turnout}</dd>
      </div>
      <div class="capstone-metric">
        <dt>Fundraising target</dt>
        <dd>{target}</dd>
      </div>
    </dl>

    {/* The card's one action. Its ::after covers the whole card, so the
        photo and the figures are clickable too, and the visible focus ring
        is drawn on the card rather than on the link. */}
    <p class="capstone-more">
      Want to learn more?
      <a href={href} class="capstone-cta">
        Click here
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m0 0-4.2-4.2M15 10l-4.2 4.2"
             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
             stroke-linejoin="round" /></svg>
        <span class="sr-only">about {title}</span>
      </a>
    </p>
  </div>
</article>

<style>
  /*
    Same geometry as `.section-card` — the run of cards down the page has to
    line up — but foil instead of paper. The gutter and the gap to the card
    above come from the `.capstones` grid on the events page, which is also
    what stretches this card to match its neighbour.
  */
  .capstone {
    position: relative;
    /* `width` is not redundant next to `max-width`: as a grid item with auto
       margins the card would otherwise be sized to fit its own text, and the
       two cards would come out different widths. */
    width: 100%;
    margin-inline: auto;
    max-width: 72rem;
    display: grid;
    /* Stacked, the photo keeps its own height and the body takes whatever
       height the card was stretched to — see `.capstone-body` for where that
       height goes. */
    grid-template-rows: auto 1fr;
    border: 1px solid rgb(155 112 18 / 0.4);
    border-radius: 1.75rem;
    background: linear-gradient(150deg, #fdf3d6 0%, #f7e3a6 44%, #eccd76 100%);
    box-shadow:
      0 1px 2px rgb(120 82 10 / 0.14),
      0 22px 46px -28px rgb(120 82 10 / 0.6);
    /* Lets the photo take the card's corners on the outer side. */
    overflow: clip;
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  @media (min-width: 768px) {
    .capstone {
      grid-template-columns: 1fr 1fr;
      /* Side by side there is only one row, and it fills the card. */
      grid-template-rows: auto;
    }
  }

  .capstone:hover {
    transform: translateY(-3px);
    box-shadow:
      0 1px 2px rgb(120 82 10 / 0.16),
      0 30px 54px -28px rgb(120 82 10 / 0.7);
  }

  .capstone:has(.capstone-cta:focus-visible) {
    outline: 3px solid #9f1239;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .capstone {
      transition: none;
    }

    .capstone:hover {
      transform: none;
    }
  }

  /* Stacked, the photo sets its own height off the card's full width: tall
     enough to still read as the headline image and not a strip, with a
     ceiling so it doesn't swallow the screen on a wide phone. */
  .capstone-photo-frame {
    position: relative;
    min-height: 15rem;
  }

  .capstone-photo {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 26rem;
    object-fit: cover;
    background: #e7d7ae;
  }

  @media (min-width: 768px) {
    /* Beside the text, the text is what says how tall the card is. Taking the
       picture out of the flow means its own proportions can't stretch the
       card — it simply covers the column, however deep that turns out to be. */
    .capstone-photo {
      position: absolute;
      inset: 0;
      max-height: none;
    }

    .capstone-flip .capstone-photo-frame {
      order: 2;
    }
  }

  .capstone-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* The card is as tall as its neighbour, so this side is usually holding a
       little more height than its own text needs. Spreading that through the
       gaps opens the lines a hair; pooling it would leave a band of bare foil
       under the last line. */
    justify-content: space-between;
    padding: 1.75rem 1.5rem 2rem;
  }

  @media (min-width: 640px) {
    .capstone-body {
      padding: 2.5rem;
    }
  }

  .capstone-eyebrow {
    font-family: var(--font-hand);
    font-size: 1.25rem;
    line-height: 1;
    letter-spacing: 0.01em;
    color: #7a5405;
    transform: rotate(-1.5deg);
  }

  .capstone-title {
    margin-top: 0.5rem;
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1.15;
    color: #3b2905;
  }

  @media (min-width: 640px) {
    .capstone-title {
      font-size: 2rem;
    }
  }

  .capstone-blurb {
    margin-top: 0.75rem;
    /* Held to a readable measure even when the card is wide. */
    max-width: 34ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #5a3f0a;
  }

  /* Paper tiles on the foil: the figures need a calm ground to sit on, and
     the same off-white as the polaroid mounts is what ties them to the rest
     of the page. */
  .capstone-metrics {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.75rem;
    width: 100%;
  }

  @media (min-width: 480px) {
    .capstone-metrics {
      grid-template-columns: 1fr 1fr;
    }
  }

  .capstone-metric {
    border: 1px solid rgb(155 112 18 / 0.28);
    border-radius: 0.875rem;
    background: rgb(255 253 246 / 0.82);
    padding: 0.875rem 1rem;
  }

  .capstone-metric dt {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #6b4c10;
  }

  .capstone-metric dd {
    margin-top: 0.125rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #3b2905;
  }

  .capstone-more {
    margin-top: 1.5rem;
    font-size: 1rem;
    color: #5a3f0a;
  }

  .capstone-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: 0.25rem;
    font-weight: 600;
    color: #9f1239;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .capstone-cta svg {
    width: 1.05em;
    height: 1.05em;
    transition: transform 200ms ease;
  }

  .capstone:hover .capstone-cta svg {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .capstone-cta svg {
      transition: none;
    }
  }

  /* Stretched link — the whole card is the target, the text stays selectable. */
  .capstone-cta::after {
    content: '';
    position: absolute;
    inset: 0;
  }
</style>
