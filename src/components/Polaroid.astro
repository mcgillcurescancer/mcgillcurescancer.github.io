---
/*
  A single photo in a polaroid frame: thin white border on three sides, a deep
  bottom margin, and a handwritten caption. Built in CSS rather than a PNG
  frame so it scales at any width and the caption stays editable text.

  Sizing is driven entirely by the frame's own width (`cqw` units against the
  frame's inline-size container), so a parent only has to set a width — the
  border, height, caption type size and pushpin all follow. That is why the
  border lives on an inner element: percentages would resolve against whatever
  the parent happens to be, and an element cannot query itself.
*/
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /**
   * Handwritten line under the photo — a date, in the classic polaroid style.
   *
   * `| undefined` is spelled out rather than left to the `?` alone: under
   * `exactOptionalPropertyTypes` those two mean different things, and both
   * callers pass `captions[i]` straight through from an array that is allowed
   * to run shorter than its row of frames. They hand over an explicit
   * `undefined` for an uncaptioned frame rather than omitting the prop, which
   * `?` on its own would not accept.
   */
  caption?: string | undefined;
  /** Turns the whole frame into a link to this destination. */
  href?: string;
  /** `gold` swaps the white card for foil — used to single out our capstone events. */
  tone?: 'white' | 'gold';
  /** Clips the frame to a line with a wooden clothespin at its top edge. */
  clip?: boolean;
  /**
   * How far the frame hangs off-square, e.g. `-2deg`. It pivots on its top
   * centre — the point the clothespin grips — so the frame swings under the
   * peg instead of dragging the peg with it.
   */
  tilt?: string;
  /** Extra positioning/rotation classes from the parent. */
  class?: string;
  /**
   * What the frame's width works out to at each breakpoint, for picking a
   * candidate off `widths`. The default covers the two layouts we have: a
   * scattered frame on the events page and a pegged one on the clothesline,
   * neither of which gets past ~250px.
   */
  sizes?: string;
}
const {
  src, alt, caption, href, tone = 'white', clip = false, tilt,
  class: className, sizes = '(min-width: 640px) 250px, 50vw',
} = Astro.props;
---

<figure
  class:list={[
    'polaroid',
    tone === 'gold' && 'polaroid-gold',
    href && 'polaroid-linked',
    clip && 'polaroid-clipped',
    className,
  ]}
  style={tilt ? `--polaroid-tilt: ${tilt}` : undefined}
>
  <div class="polaroid-frame">
    {/* The frame is small and never grows past a few hundred pixels, so the
        candidates stop well short of the source file's full size — see `sizes`
        above. CSS does the square crop, so no height is set here.

        `width` has to match the largest candidate. It is what the fallback
        `src` gets rendered at, and without it Astro falls back to the source's
        intrinsic width — which on our 6000px event photos meant shipping a
        4MB file per polaroid that no `srcset`-aware browser ever asks for. */}
    <Image
      src={src}
      alt={alt}
      widths={[200, 300, 400, 600]}
      width={600}
      sizes={sizes}
      loading="lazy"
      decoding="async"
      class="polaroid-photo"
    />
    {caption && <figcaption class="polaroid-caption">{caption}</figcaption>}
  </div>

  {clip && (
    /*
      A wooden clothespin, gripping the top border of the frame with the line
      running behind its spring. Drawn at a fixed size rather than in `cqw`:
      a real peg is the same peg whatever it is holding up, and a constant
      height is what keeps every peg sitting on the line at the same place.
    */
    <svg class="polaroid-clip" viewBox="0 0 26 46" aria-hidden="true">
      <path d="M4 3.2 L11 2.6 L12.2 44.4 L5.3 44.4 Z" fill="#dcb37c" />
      <path d="M22 3.2 L15 2.6 L13.8 44.4 L20.7 44.4 Z" fill="#caa066" />
      <path d="M11 2.6 L12.2 44.4 L11.2 44.4 L10 2.7 Z" fill="#a97f4a" opacity="0.45" />
      <path d="M15 2.6 L13.8 44.4 L14.8 44.4 L16 2.7 Z" fill="#a97f4a" opacity="0.3" />
      <rect x="3.2" y="18" width="19.6" height="3.6" rx="1.8" fill="#c2cad3" />
      <rect x="3.2" y="18" width="19.6" height="1.4" rx="0.7" fill="#eef1f4" opacity="0.8" />
      <circle cx="13" cy="19.8" r="3" fill="#aeb7c1" />
      <circle cx="13" cy="19.8" r="1.2" fill="#7f8894" />
    </svg>
  )}

  {/* Stretched link: the anchor itself is a sliver, but its ::after covers the
      whole frame, so the border and the caption are clickable too without
      nesting the image inside the anchor. */}
  {href && <a href={href} class="polaroid-link"><span class="sr-only">{alt || caption}</span></a>}
</figure>

<style>
  /* Carries only the width the parent sets; everything inside sizes against
     it through `cqw`. */
  .polaroid {
    container-type: inline-size;
  }

  .polaroid-frame {
    background: #fdfcf8;
    padding: 5.5cqw 5.5cqw 0;
    /* Pivoting on the top centre keeps that point fixed under any tilt, so a
       peg placed there never drifts off the corner it is gripping. */
    transform: rotate(var(--polaroid-tilt, 0deg));
    transform-origin: top center;
    transition: transform 200ms ease;
    border-radius: 2px;
    box-shadow:
      0 12px 28px -10px rgb(15 23 42 / 0.4),
      0 2px 5px rgb(15 23 42 / 0.14);
  }

  /* Foil card. The photo keeps its white mount so the gold frames the picture
     instead of tinting it. */
  .polaroid-gold .polaroid-frame {
    background:
      linear-gradient(145deg, #fbe6a8 0%, #e8bc4e 38%, #d9a324 62%, #b8871a 100%);
    box-shadow:
      0 14px 30px -10px rgb(120 82 10 / 0.55),
      0 2px 5px rgb(15 23 42 / 0.2);
  }

  .polaroid-gold .polaroid-photo {
    /* A hairline mount keeps the photo from bleeding into the foil. */
    outline: 0.8cqw solid #fdfcf8;
    outline-offset: 0;
  }

  .polaroid-gold .polaroid-caption {
    color: #5a3c05;
  }

  .polaroid-linked {
    position: relative;
  }

  .polaroid-clipped {
    position: relative;
    /* Above the line that runs behind it. */
    z-index: 1;
  }

  /* Half the peg stands above the frame, so the line crossing the frame's top
     edge passes behind the spring. */
  .polaroid-clip {
    /* Scales with the frame where the parent sets a card width, within limits
       either side — a peg is a real object, not a drawing that grows without
       bound. `top` stays at the same fraction of the height, which is what
       keeps the spring on the line at every size. */
    --clip-h: clamp(2rem, var(--card, 11rem) * 0.21, 2.75rem);
    position: absolute;
    top: calc(var(--clip-h) * -0.4364);
    left: 50%;
    z-index: 2;
    height: var(--clip-h);
    width: auto;
    transform: translateX(-50%);
    filter: drop-shadow(0 3px 3px rgb(60 32 8 / 0.35));
  }

  /* The frame swings out from under the peg on hover; the peg stays put. */
  .polaroid-linked:hover .polaroid-frame,
  .polaroid-linked:has(.polaroid-link:focus-visible) .polaroid-frame {
    transform: rotate(var(--polaroid-tilt, 0deg)) scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .polaroid-frame {
      transition: none;
    }
  }

  .polaroid-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* The frame is the visible target, so the ring goes on it, not on the
     sliver of an anchor. */
  .polaroid-linked:has(.polaroid-link:focus-visible) {
    outline: 3px solid #be123c;
    outline-offset: 3px;
  }

  .polaroid-photo {
    display: block;
    width: 100%;
    /* Square crop is what makes a stack of mixed photos read as polaroids. */
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background: #e2e8f0;
    /* Slight lift off the white frame so the photo reads as a separate layer. */
    box-shadow: 0 1px 4px rgb(15 23 42 / 0.18);
  }

  .polaroid-caption {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 22cqw;
    font-family: var(--font-hand);
    font-size: 10cqw;
    line-height: 1;
    color: #334155;
    /* Nobody writes perfectly level on a polaroid. */
    transform: rotate(-1.5deg);
  }

  /* Keep the frame's own height stable when there is no caption. */
  .polaroid-frame:not(:has(.polaroid-caption)) {
    padding-bottom: 5.5cqw;
  }
</style>
