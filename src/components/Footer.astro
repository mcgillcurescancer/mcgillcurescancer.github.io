---
// TODO(placeholder): replace the email and Instagram handle below with the
// club's real contact details before this goes live — these are invented.
const year = new Date().getFullYear();
---

<footer id="contact" class="mt-20 border-t border-slate-200 bg-slate-50">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-2">
    <div>
      <img src="/assets/images/logos/mcc/full-mcc.PNG" alt="McGill Cure Cancer"
           width="160" height="60" class="h-14 w-auto" />
      <p class="mt-3 max-w-sm text-sm text-slate-600">
        We fundraise for cancer research through organized sporting events at
        McGill University. All funds are donated to the Canadian Cancer Society.
      </p>
    </div>

    <div class="sm:justify-self-end">
      <h2 class="text-sm font-semibold text-slate-900">Get in touch</h2>
      <ul class="mt-3 space-y-2 text-sm text-slate-600">
        <li>
          <a class="hover:text-mcc-600" href="mailto:mcgillcurescancer@ssmu.ca">
            mcgillcurescancer@ssmu.ca
          </a>
        </li>
        <li>
          <a class="hover:text-mcc-600" href="https://www.instagram.com/mcgillcurescancer/"
             rel="me noopener" target="_blank">Instagram</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-slate-200 px-4 py-4 text-center text-xs text-slate-500">
    &copy; {year} McGill Cure Cancer
  </div>
</footer>
