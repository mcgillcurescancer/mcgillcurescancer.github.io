---
import Doodle from './Doodle.astro';

// TODO(placeholder): replace the email and Instagram handle below with the
// club's real contact details before this goes live — these are invented.
const year = new Date().getFullYear();
---

<!-- One last pen mark on the page before it hands over to the footer's white.
     It lives here rather than on each page so every page signs off the same
     way. -->
<Doodle variant="triple" class="mt-16" />

<footer id="contact" class="mt-8 border-t border-stone-200 bg-white">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-2">
    <div>
      <!-- Same split lockup as the header: the stock full logo stacks the
           ribbon above the wordmark, so ribbon and wordmark are placed side by
           side here to match what the nav shows. -->
      <div class="flex items-center gap-2">
        <img src="/assets/images/logos/mcc/mcc-ribbon-mark.svg" alt=""
             width="504" height="820" class="h-10 w-auto" />
        <img src="/assets/images/logos/mcc/mcc-wordmark.svg" alt="McGill Cures Cancer"
             width="799" height="338" class="h-10 w-auto" />
      </div>
      <p class="mt-3 max-w-sm text-sm text-slate-600">
        We fundraise for cancer research through organized sporting events at
        McGill University. All funds are donated to the Canadian Cancer Society.
      </p>
    </div>

    <div class="sm:justify-self-end">
      <h2 class="text-sm font-semibold text-slate-900">Get in touch</h2>
      <ul class="mt-3 space-y-2 text-sm text-slate-600">
        <li>
          <a class="hover:text-mcc-600" href="mailto:mcgillcurescancer@ssmu.ca">
            mcgillcurescancer@ssmu.ca
          </a>
        </li>
        <li>
          <a class="hover:text-mcc-600" href="https://www.instagram.com/mcgillcurescancer/"
             rel="me noopener" target="_blank">Instagram</a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Three ticks of the accent inks against the closing rule, so the page
       signs off in the club's colours instead of on plain grey. -->
  <div class="border-t border-stone-200">
    <div class="mx-auto flex max-w-6xl items-center justify-center gap-1.5 pt-3" aria-hidden="true">
      <span class="h-1 w-6 rounded-full bg-doodle-red"></span>
      <span class="h-1 w-4 rounded-full bg-doodle-yellow"></span>
      <span class="h-1 w-2 rounded-full bg-doodle-ink/70"></span>
    </div>
    <p class="px-4 pt-2 pb-4 text-center text-xs text-slate-500">
      &copy; {year} McGill Cures Cancer
    </p>
  </div>
</footer>
