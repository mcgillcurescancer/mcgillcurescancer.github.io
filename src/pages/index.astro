---
/*
  The Landing page — moves top to bottom, one image paired with a blurb of text.

  1. Hero .......... team photo, full viewport, scrolls away on first scroll
  2. About ......... who we are, flanked by the CCS and MCC marks (#about)
  3. Events ........ one polaroid per event, each linking into the events page
  4. Sponsorships .. pitch + rotating sponsor logos
*/
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Polaroid from '../components/Polaroid.astro';
import Doodle from '../components/Doodle.astro';
import SponsorWall from '../components/SponsorWall.astro';

// Imported rather than referenced by path: that is what puts them through
// Astro's image pipeline, which emits the resized variants and hashes the
// filenames for long-lived caching.
import teamPic from '../assets/images/team/team-pic.webp';
import classicPhoto from '../assets/images/events/mcgill-classic/mcgill-classic-1.webp';
import evmPhoto from '../assets/images/events/eng-vs-management/eng-vs-management-1.webp';
import threeVthree from '../assets/images/events/3v3-tournament/3v3-1.webp';
import dodgeball from '../assets/images/events/dodgeball-tournament/dodgeball-1.webp';
import barNight from '../assets/images/events/bar-night/bar-night-1.webp';

/*
  One polaroid per event, pinned up in a single row. The first two are our
  capstone events: they get their own pages and a gold card so sponsors read
  them as the headline acts. The rest link to their section on the events
  page, so these anchors have to match the `id`s in src/pages/events/index.astro.

  Each event's photo here is the first of the run in its folder, which is also
  the one that leads its pile on the events page — the same picture in both
  places, so the line reads as an index of what is further in.
*/
/*
  One period of the line, drawn three times across: crests at 0 / 122 / 244 /
  366 and dips at 61 / 183 / 305, in a viewBox 366 units wide by 14 tall where
  100 units is one card. Every horizontal number here is a multiple of the
  column pitch (1.22 cards), which is what lets neighbouring copies coincide.
*/
const CORD = `M0 3 C18 3.6 40 8.4 61 10 C84 9.6 104 5.2 122 3
              C140 3.6 162 8.4 183 10 C206 9.6 226 5.2 244 3
              C262 3.6 284 8.4 305 10 C328 9.6 348 5.2 366 3`;

const events = [
  {
    src: classicPhoto,
    alt: 'The McGill Classic',
    caption: 'The McGill Classic',
    href: '/events/mcgill-classic/',
    tone: 'gold' as const,
    tilt: '-2deg',
  },
  {
    src: evmPhoto,
    alt: 'Engineering vs. Management',
    caption: 'Eng vs. Management',
    href: '/events/eng-vs-management/',
    tone: 'gold' as const,
    tilt: '1.5deg',
  },
  {
    src: threeVthree,
    alt: '3v3 basketball tournament',
    caption: '3v3 tournament',
    href: '/events/#3v3-tournament',
    tilt: '-1deg',
  },
  {
    src: dodgeball,
    alt: 'Dodgeball tournament',
    caption: 'Dodgeball',
    href: '/events/#dodgeball-tournament',
    tilt: '2deg',
  },
  {
    src: barNight,
    alt: 'Bar night at Ye Olde Orchard',
    caption: 'Bar night',
    href: '/events/#bar-night',
    tilt: '-1.5deg',
  },
];
---

<Layout
  title="McGill Cures Cancer"
  description="We fundraise for cancer research through organized sporting events at McGill University. Join us in the fight against cancer."
  image={teamPic}
  overlayNav
>
  <!-- 1. Hero — the team photo owns the whole first screen. It sits in normal
       flow (not fixed), so the moment you scroll it leaves with everything
       else rather than lingering as a backdrop behind the sections below. -->
  <!-- `bg-hero-backdrop` is never seen as a colour: the photo covers it. It is
       there because the photo's own edges are anti-aliased, and on a screen
       whose device pixel ratio is not a whole number they land mid-pixel and
       blend with whatever is behind — which used to be the off-white page, and
       showed up as a pale sliver down the right of the hero and across its
       bottom. Blending into near-black instead, the edge reads as shadow. The
       page background carries the matching half of this fix; see
       `html[data-hero]` in src/styles/global.css. -->
  <section class="relative flex h-svh min-h-[32rem] flex-col justify-end overflow-hidden bg-hero-backdrop">
    {/* The page's LCP. It stays eager and high-priority — `<Image>` would
        otherwise lazy-load it — while `widths` keeps a phone off the 2048px
        original it was being served before. */}
    <Image
      src={teamPic}
      alt="The McGill Cures Cancer team at one of our tournaments"
      widths={[640, 960, 1280, 1600, 2048]}
      sizes="100vw"
      loading="eager" fetchpriority="high" decoding="async"
      class="absolute inset-0 h-full w-full object-cover object-[50%_70%]"
    />

    <!-- Two scrims in one gradient: enough shade at the top for the floating
         header, enough at the bottom for the headline. The middle stays clear
         so the faces are not muddied. -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/55 via-black/10 via-40% to-black/80"
         aria-hidden="true"></div>

    <div class="relative mx-auto w-full max-w-6xl px-4 pb-20 sm:pb-24">
      <h1 class="max-w-3xl text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
        Join us in the fight against cancer.
      </h1>
      <p class="mt-5 max-w-xl text-lg text-white/90">
        We fundraise for cancer research through organized sporting events at
        McGill University.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/events/"
           class="rounded-lg bg-mcc-600 px-5 py-3 text-sm font-semibold text-white shadow-lg hover:bg-mcc-700">
          See our events
        </a>
        <a href="#sponsorships"
           class="rounded-lg border border-white/60 bg-white/10 px-5 py-3 text-sm font-semibold text-white backdrop-blur hover:bg-white/20">
          Sponsor us
        </a>
      </div>
    </div>
  </section>

  <!-- 2. About — the target for the header's "About" link, so it has to be the
       first thing under the hero. The two marks bracket the copy: the Canadian
       Cancer Society daffodil on one side, our ribbon on the other, with the
       partnership spelled out between them. Placeholder copy for now. -->
  <section id="about" class="section-shell scroll-mt-24 pt-8 sm:pt-12">
    <div class="section-card flex flex-col items-center gap-10 md:flex-row md:justify-between md:gap-10">
      <!-- Flower only, no wordmark — the lockup's type would out-shout the
           heading at this size. Cropped out of ccs-logo.svg. -->
      <img src="/assets/images/logos/ccs/ccs-flower.svg" alt="Canadian Cancer Society"
           loading="lazy" width="192" height="192"
           class="h-32 w-32 shrink-0 md:h-40 md:w-40 lg:h-48 lg:w-48" />

      <div class="max-w-lg text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900">
          <span class="hand-underline">Who we are</span>
        </h2>
        <p class="mt-4 text-lg text-slate-700">
          McGill Cures Cancer is a student-run club that turns sport into
          funding for cancer research. We put on tournaments, bar nights and
          charity games across campus, and every dollar they raise goes to the
          same place.
        </p>
        <p class="mt-4 text-lg text-slate-700">
          We're fully partnered with the <strong>Canadian Cancer Society</strong>.
          All funds we generate are donated to the CCS.
        </p>
      </div>

      <img src="/assets/images/logos/mcc/mcc-ribbon.svg" alt="McGill Cures Cancer"
           loading="lazy" width="425" height="689"
           class="h-40 w-auto shrink-0 md:h-48 lg:h-56" />
    </div>
  </section>

  <!-- Pen marks in the gap between two cards. They carry no meaning; they are
       there so the run of white cards reads as a scrapbook rather than a
       stack of panels. Alternate the variants — the same one twice in a row
       starts to look like a border again. -->
  <Doodle variant="wave" />

  <!-- 3. Events — every event pegged to a washing line. The two capstone
       events lead the line on gold cards; the rest are plain white. Each frame
       is a link into the events page. -->
  <section id="events" class="section-shell scroll-mt-24">
    <div class="section-card">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900">
          A glimpse into <span class="hand-underline">our events</span>
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">
          Tap any photo to see how that event runs.
        </p>
      </div>

      <!--
        Five across on a wide screen, three-then-two on a phone — every event on
        screen at once, no sideways scrolling. The line is not one long drawing
        spanning the row: each frame carries its own three-span piece of cord,
        phase-locked to the column pitch so a piece traces exactly the same curve
        as its neighbours over the stretch they share. Overlapping copies land on
        top of each other and read as one continuous line, and because the pieces
        travel with the frames, a row that wraps gets a whole line of its own.
      -->
      <div class="clothesline mt-14">
        <div class="clothesline-grid">
          {events.map((event) => (
            <div class="peg">
              <svg class="peg-string" viewBox="0 0 366 14" preserveAspectRatio="none" aria-hidden="true">
                {/* Three dips: the middle one (x=183) is this frame's, the outer
                    two sit under whatever is pegged up on either side. */}
                <path class="peg-cord" d={CORD} />
                <path class="peg-twist" d={CORD} />
              </svg>
              {/* `--card` is capped at 13rem, so the photo inside it never
                  passes 0.89 * 208px. Below the container's 40rem step the row
                  is three across, i.e. 1/3.44 of the line's width. */}
              <Polaroid
                {...event}
                clip
                class="w-full"
                sizes="(min-width: 640px) 185px, calc((100vw - 112px) * 0.26)"
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Doodle variant="loop" />

  <!-- 4. Sponsorships -->
  <section id="sponsorships" class="section-shell scroll-mt-24">
    <div class="section-card text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900">
        Interested in <span class="hand-underline">sponsoring us</span>?
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-slate-600">
        Get in touch at
        <a href="mailto:mcgillcurescancer@ssmu.ca" class="font-medium text-mcc-600 underline">mcgillcurescancer@ssmu.ca</a>
        or reach out on
        <a href="https://www.instagram.com/mcgillcurescancer/" rel="noopener" target="_blank"
           class="font-medium text-mcc-600 underline">Instagram</a>.
        We love partnering with local Montreal companies.
      </p>

      <!-- The wall is part of the same pitch, so it shares the card rather
           than starting a new one. -->
      <SponsorWall heading="Some of our sponsors" bare class="mt-16" />
    </div>
  </section>
</Layout>

<style>
  /*
    Everything on the line is a multiple of the card width, so the whole
    arrangement — gaps, how deep the frames hang, the size of each piece of
    cord — stays in proportion at any size. `--card` is solved from the column
    count so the row fills the container exactly: n cards plus n-1 gaps of
    0.22 cards is (1.22n - 0.22) cards wide.
  */
  .clothesline {
    container-type: inline-size;
    padding-inline: 1rem;
    /* The cord runs a column-and-a-half past the frames at each end of a row,
       so it is left to run right off the section card and be cut by the card's
       own `overflow: clip` — the line reads as strung across the paper and
       disappearing behind its edge.

       `isolation` is what keeps it visible at all: each piece of cord sits at
       `z-index: -1` so it passes behind the pegs, and without a stacking
       context of its own here that would drop it behind the card's white
       background instead. */
    isolation: isolate;
  }

  .clothesline-grid {
    --cols: 3;
    --card: min(13rem, calc(100cqw / (var(--cols) * 1.22 - 0.22)));
    --gap: calc(var(--card) * 0.22);
    /* How far below the crests the frames hang — the depth of a dip. */
    --dip: calc(var(--card) * 0.1);
    /* Half a column, to centre a short last row. Zeroed once everything fits
       on one line. */
    --nudge: calc((var(--card) + var(--gap)) / 2);
    display: grid;
    grid-template-columns: repeat(var(--cols), var(--card));
    justify-content: center;
    column-gap: var(--gap);
    row-gap: calc(var(--card) * 0.3);
  }

  /* Five fit comfortably from here up. There is no four-column step: it would
     leave a single frame stranded on a line of its own. */
  @container (min-width: 40rem) {
    .clothesline-grid {
      --cols: 5;
      --nudge: 0px;
    }
  }

  .peg {
    position: relative;
    padding-top: var(--dip);
  }

  /* On three columns the five frames fall 3 + 2, leaving the last two in
     columns one and two so the second line reads as left-aligned. `--nudge`
     slides the pair half a column over to centre it. A relative offset rather
     than a transform on purpose: a transform would box each frame's cord into
     its own stacking context, and the copy that runs past a neighbour would
     then cross over its peg instead of behind it. */
  .peg:nth-child(4),
  .peg:nth-child(5) {
    left: var(--nudge);
  }

  /*
    Three column-pitches wide, centred on the frame, and sitting behind every
    frame on the line — including its neighbours', so the copies that run past
    them pass behind their pegs rather than over their faces.
  */
  .peg-string {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: -1;
    width: calc(var(--card) * 3.66);
    height: calc(var(--card) * 0.14);
    transform: translateX(-50%);
    pointer-events: none;
    /* Solid across the middle span, fading out over the two either side. On an
       inner frame the faded stretch is covered by a neighbour's solid one; on
       the frame that ends a row there is nothing to cover it, so the line
       trails off instead of stopping dead. */
    -webkit-mask-image: linear-gradient(to right, transparent, #000 33.33%, #000 66.67%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 33.33%, #000 66.67%, transparent);
  }

  .peg-cord,
  .peg-twist {
    fill: none;
    stroke-linecap: round;
  }

  .peg-cord {
    stroke: #8c0d2c;
    stroke-width: 1.3;
  }

  .peg-twist {
    stroke: #dc2648;
    stroke-width: 0.55;
  }
</style>
