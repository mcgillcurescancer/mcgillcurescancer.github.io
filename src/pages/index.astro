---
/*
  The Landing page — moves top to bottom, one image paired with a blurb of text.

  1. Hero .......... team photo, full viewport, scrolls away on first scroll
  2. About ......... who we are, flanked by the CCS and MCC marks (#about)
  3. Sponsorships .. pitch + rotating sponsor logos
*/
import Layout from '../layouts/Layout.astro';
import SponsorWall from '../components/SponsorWall.astro';
---

<Layout
  title="McGill Cures Cancer"
  description="We fundraise for cancer research through organized sporting events at McGill University. Join us in the fight against cancer."
  image="/assets/images/team/team-pic.webp"
  overlayNav
>
  <!-- 1. Hero — the team photo owns the whole first screen. It sits in normal
       flow (not fixed), so the moment you scroll it leaves with everything
       else rather than lingering as a backdrop behind the sections below. -->
  <section class="relative flex h-svh min-h-[32rem] flex-col justify-end overflow-hidden">
    <img
      src="/assets/images/team/team-pic.webp"
      alt="The McGill Cures Cancer team at one of our tournaments"
      width="2048" height="1536"
      fetchpriority="high" decoding="async"
      class="absolute inset-0 h-full w-full object-cover object-[50%_70%]"
    />

    <!-- Two scrims in one gradient: enough shade at the top for the floating
         header, enough at the bottom for the headline. The middle stays clear
         so the faces are not muddied. -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/55 via-black/10 via-40% to-black/80"
         aria-hidden="true"></div>

    <div class="relative mx-auto w-full max-w-6xl px-4 pb-20 sm:pb-24">
      <h1 class="max-w-3xl text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
        Join us in the fight against cancer.
      </h1>
      <p class="mt-5 max-w-xl text-lg text-white/90">
        We fundraise for cancer research through organized sporting events at
        McGill University.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/events/"
           class="rounded-lg bg-mcc-600 px-5 py-3 text-sm font-semibold text-white shadow-lg hover:bg-mcc-700">
          See our events
        </a>
        <a href="#sponsorships"
           class="rounded-lg border border-white/60 bg-white/10 px-5 py-3 text-sm font-semibold text-white backdrop-blur hover:bg-white/20">
          Sponsor us
        </a>
      </div>
    </div>
  </section>

  <!-- 2. About — the target for the header's "About" link, so it has to be the
       first thing under the hero. The two marks bracket the copy: the Canadian
       Cancer Society daffodil on one side, our ribbon on the other, with the
       partnership spelled out between them. Placeholder copy for now. -->
  <section id="about" class="scroll-mt-24 bg-canvas-alt py-20">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-10 px-4 md:flex-row md:justify-center md:gap-14 lg:gap-20">
      <!-- Flower only, no wordmark — the lockup's type would out-shout the
           heading at this size. Cropped out of ccs-logo.svg. -->
      <img src="/assets/images/logos/ccs/ccs-flower.svg" alt="Canadian Cancer Society"
           loading="lazy" width="192" height="192"
           class="h-28 w-28 shrink-0 sm:h-32 sm:w-32" />

      <div class="max-w-lg text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900">Who we are</h2>
        <p class="mt-4 text-lg text-slate-700">
          McGill Cures Cancer is a student-run club that turns sport into
          funding for cancer research. We put on tournaments, bar nights and
          charity games across campus, and every dollar they raise goes to the
          same place.
        </p>
        <p class="mt-4 text-lg text-slate-700">
          We're fully partnered with the <strong>Canadian Cancer Society</strong>.
          All funds we generate are donated to the CCS.
        </p>
      </div>

      <img src="/assets/images/logos/mcc/mcc-ribbon.svg" alt="McGill Cures Cancer"
           loading="lazy" width="980" height="1225"
           class="h-36 w-auto shrink-0 sm:h-44" />
    </div>
  </section>

  <!-- 3. Sponsorships -->
  <section id="sponsorships" class="mx-auto max-w-6xl scroll-mt-24 px-4 pt-16 text-center">
    <h2 class="text-3xl font-bold tracking-tight text-slate-900">Interested in sponsoring us?</h2>
    <p class="mx-auto mt-4 max-w-2xl text-slate-600">
      Check out <a href="/events/" class="font-medium text-mcc-600 underline">a few of our events</a>.
      We love partnering with local Montreal companies.
    </p>
  </section>
  <SponsorWall heading="Some of our sponsors" />
</Layout>
