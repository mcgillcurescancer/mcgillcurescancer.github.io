---
/*
  The Landing page — moves top to bottom, one image paired with a blurb of text.

  1. Hero .......... team photo, full viewport, scrolls away on first scroll
  2. About ......... who we are, flanked by the CCS and MCC marks (#about)
  3. Events ........ one polaroid per event, each linking into the events page
  4. Sponsorships .. pitch + rotating sponsor logos
*/
import Layout from '../layouts/Layout.astro';
import Polaroid from '../components/Polaroid.astro';
import SponsorWall from '../components/SponsorWall.astro';

/*
  One polaroid per event, pinned up in a single row. The first two are our
  capstone events: they get their own pages and a gold card so sponsors read
  them as the headline acts. The rest link to their section on the events
  page, so these anchors have to match the `id`s in src/pages/events/index.astro.

  TODO: eng-vs-management and mcgill-classic use stock placeholder photos
  (`*-placeholder.jpg`) until the real event photos land. Swap the `src` and
  drop the placeholder files when they do.
*/
const events = [
  {
    src: '/assets/images/events/eng-vs-management/evm-placeholder.jpg',
    alt: 'Engineering vs. Management',
    caption: 'Eng vs. Management',
    href: '/events/eng-vs-management/',
    tone: 'gold' as const,
    tilt: '-2deg',
    /* Where the frame hangs on the line. These have to track the sag in the
       string path below: each one is the y the path reaches at that peg. */
    hang: 'mt-[19px]',
  },
  {
    src: '/assets/images/events/mcgill-classic/classic-placeholder.jpg',
    alt: 'The McGill Classic',
    caption: 'The McGill Classic',
    href: '/events/mcgill-classic/',
    tone: 'gold' as const,
    tilt: '1.5deg',
    hang: 'mt-[36px]',
  },
  {
    src: '/assets/images/events/3v3-tournament/3v3-1.webp',
    alt: '3v3 basketball tournament',
    caption: '3v3 tournament',
    href: '/events/#3v3-tournament',
    tilt: '-1deg',
    hang: 'mt-[43px]',
  },
  {
    src: '/assets/images/events/dodgeball-tournament/dodgeball-1.webp',
    alt: 'Dodgeball tournament',
    caption: 'Dodgeball',
    href: '/events/#dodgeball-tournament',
    tilt: '2deg',
    hang: 'mt-[39px]',
  },
  {
    src: '/assets/images/events/bar-night/bar-night-1.webp',
    alt: 'Bar night at Ye Olde Orchard',
    caption: 'Bar night',
    href: '/events/#bar-night',
    tilt: '-1.5deg',
    hang: 'mt-[23px]',
  },
];
---

<Layout
  title="McGill Cures Cancer"
  description="We fundraise for cancer research through organized sporting events at McGill University. Join us in the fight against cancer."
  image="/assets/images/team/team-pic.webp"
  overlayNav
>
  <!-- 1. Hero — the team photo owns the whole first screen. It sits in normal
       flow (not fixed), so the moment you scroll it leaves with everything
       else rather than lingering as a backdrop behind the sections below. -->
  <section class="relative flex h-svh min-h-[32rem] flex-col justify-end overflow-hidden">
    <img
      src="/assets/images/team/team-pic.webp"
      alt="The McGill Cures Cancer team at one of our tournaments"
      width="2048" height="1536"
      fetchpriority="high" decoding="async"
      class="absolute inset-0 h-full w-full object-cover object-[50%_70%]"
    />

    <!-- Two scrims in one gradient: enough shade at the top for the floating
         header, enough at the bottom for the headline. The middle stays clear
         so the faces are not muddied. -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/55 via-black/10 via-40% to-black/80"
         aria-hidden="true"></div>

    <div class="relative mx-auto w-full max-w-6xl px-4 pb-20 sm:pb-24">
      <h1 class="max-w-3xl text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
        Join us in the fight against cancer.
      </h1>
      <p class="mt-5 max-w-xl text-lg text-white/90">
        We fundraise for cancer research through organized sporting events at
        McGill University.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/events/"
           class="rounded-lg bg-mcc-600 px-5 py-3 text-sm font-semibold text-white shadow-lg hover:bg-mcc-700">
          See our events
        </a>
        <a href="#sponsorships"
           class="rounded-lg border border-white/60 bg-white/10 px-5 py-3 text-sm font-semibold text-white backdrop-blur hover:bg-white/20">
          Sponsor us
        </a>
      </div>
    </div>
  </section>

  <!-- 2. About — the target for the header's "About" link, so it has to be the
       first thing under the hero. The two marks bracket the copy: the Canadian
       Cancer Society daffodil on one side, our ribbon on the other, with the
       partnership spelled out between them. Placeholder copy for now. -->
  <section id="about" class="scroll-mt-24 py-20">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-10 px-4 md:flex-row md:justify-between md:gap-10">
      <!-- Flower only, no wordmark — the lockup's type would out-shout the
           heading at this size. Cropped out of ccs-logo.svg. -->
      <img src="/assets/images/logos/ccs/ccs-flower.svg" alt="Canadian Cancer Society"
           loading="lazy" width="192" height="192"
           class="h-32 w-32 shrink-0 md:h-40 md:w-40 lg:h-48 lg:w-48" />

      <div class="max-w-lg text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900">Who we are</h2>
        <p class="mt-4 text-lg text-slate-700">
          McGill Cures Cancer is a student-run club that turns sport into
          funding for cancer research. We put on tournaments, bar nights and
          charity games across campus, and every dollar they raise goes to the
          same place.
        </p>
        <p class="mt-4 text-lg text-slate-700">
          We're fully partnered with the <strong>Canadian Cancer Society</strong>.
          All funds we generate are donated to the CCS.
        </p>
      </div>

      <img src="/assets/images/logos/mcc/mcc-ribbon.svg" alt="McGill Cures Cancer"
           loading="lazy" width="425" height="689"
           class="h-40 w-auto shrink-0 md:h-48 lg:h-56" />
    </div>
  </section>

  <!-- 3. Events — every event pegged to one washing line. The two capstone
       events lead the line on gold cards; the rest are plain white. Each frame
       is a link into the events page. -->
  <section id="events" class="scroll-mt-24 py-20">
    <div class="mx-auto max-w-6xl px-4 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900">
        A glimpse into our events
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">
        Tap any photo to see how that event runs.
      </p>
    </div>

    <!--
      The line is one continuous piece, so the row never wraps: the frames are
      sized off the viewport and the whole line slides sideways once five of
      them stop fitting. Every horizontal position below — the peg spacing and
      the x of each dip in the string — comes out of the same card-to-gap
      ratio, which is why the gap is expressed as a fraction of the card.
    -->
    <div class="clothesline mt-14">
      <div class="clothesline-track">
        <svg class="clothesline-string" viewBox="0 0 1000 56"
             preserveAspectRatio="none" aria-hidden="true">
          <!-- Drawn twice: a dark cord with a lighter twist on top, so it
               reads as string rather than a ruled line. Both dip through the
               five peg positions (85, 292.5, 500, 707.5, 915). -->
          <path class="clothesline-cord"
                d="M0 9 C 30 12.8, 55 16, 85 19 C 140 25, 228 32, 292 36.5
                   C 372 41.3, 448 43, 500 43.1 C 574 43, 652 41.4, 708 38.6
                   C 792 34.2, 866 27.8, 915 23.4 C 946 20.4, 976 16.8, 1000 14" />
          <path class="clothesline-twist"
                d="M0 9 C 30 12.8, 55 16, 85 19 C 140 25, 228 32, 292 36.5
                   C 372 41.3, 448 43, 500 43.1 C 574 43, 652 41.4, 708 38.6
                   C 792 34.2, 866 27.8, 915 23.4 C 946 20.4, 976 16.8, 1000 14" />
        </svg>
        <span class="clothesline-tack clothesline-tack-start" aria-hidden="true"></span>
        <span class="clothesline-tack clothesline-tack-end" aria-hidden="true"></span>

        <!-- Width and snapping ride on utility classes rather than this page's
             scoped CSS: the class lands on a child component's root element,
             which this page's scope attribute does not reach. -->
        {events.map(({ hang, ...event }) => (
          <Polaroid {...event} clip class:list={['w-[var(--card)] shrink-0 snap-center', hang]} />
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Sponsorships -->
  <section id="sponsorships" class="mx-auto max-w-6xl scroll-mt-24 px-4 pt-16 text-center">
    <h2 class="text-3xl font-bold tracking-tight text-slate-900">Interested in sponsoring us?</h2>
    <p class="mx-auto mt-4 max-w-2xl text-slate-600">
      Check out <a href="/events/" class="font-medium text-mcc-600 underline">a few of our events</a>.
      We love partnering with local Montreal companies.
    </p>
  </section>
  <SponsorWall heading="Some of our sponsors" />
</Layout>

<style>
  /*
    Card and gap are locked to one ratio (gap = 0.22 x card), which fixes the
    peg positions as fractions of the line no matter how wide the cards get:
    centres land at 8.5%, 29.25%, 50%, 70.75% and 91.5%. Those are the x
    values the string's dips are drawn at, and the `mt-[…px]` on each frame is
    the depth the string has reached by then.
  */
  .clothesline {
    --card: clamp(8.5rem, 16vw, 13rem);
    --gap: calc(var(--card) * 0.22);
    /* Room for the pegs standing above the highest frame, and for the shadow
       under the lowest. Both matter: a sideways scroller clips vertically. */
    padding: 1.75rem 1rem 2.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }

  .clothesline-track {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--gap);
    /* Sized by its contents, so the string spans the whole line rather than
       the slice of it currently on screen. */
    width: max-content;
    margin-inline: auto;
  }

  .clothesline-string {
    position: absolute;
    inset-inline: 0;
    top: 0;
    /* Vertical scale stays 1:1 with the viewBox, so the sag is the same few
       pixels on every screen and the frames' offsets keep matching it. */
    height: 56px;
    width: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .clothesline-cord,
  .clothesline-twist {
    fill: none;
    stroke-linecap: round;
    /* Without this the stroke would stretch with the line's width. */
    vector-effect: non-scaling-stroke;
  }

  .clothesline-cord {
    stroke: #8c0d2c;
    stroke-width: 2.6;
  }

  .clothesline-twist {
    stroke: #dc2648;
    stroke-width: 1.1;
  }

  /* The nails the line is tied off to, sitting on the ends of the path. */
  .clothesline-tack {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 30%, #7c8894, #3f4954 70%);
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.4);
  }

  .clothesline-tack-start {
    left: -4px;
    top: 5px;
  }

  .clothesline-tack-end {
    right: -4px;
    top: 10px;
  }
</style>
