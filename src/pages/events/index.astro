---
/*
  The events page, read top to bottom:

  1. Capstone events .. the McGill Classic and Eng vs. Management, three
                        gold-framed polaroids each, captioned with the name
                        and the two numbers
  2. Past events ...... last year's smaller events, as scattered polaroids
  3. Sponsors ......... the wall

  Both capstone events have their own page under this folder, and the cards
  here are the doorway to them. See the `capstones` note below.
*/
import Layout from '../../layouts/Layout.astro';
import CapstoneCard from '../../components/CapstoneCard.astro';
import EventShowcase from '../../components/EventShowcase.astro';
import SponsorWall from '../../components/SponsorWall.astro';
import Doodle from '../../components/Doodle.astro';

/*
  TODO: eng-vs-management and mcgill-classic use stock placeholder photos
  (`*-placeholder.jpg`) until the real event photos land. Each capstone card
  shows a pile of three, and there is only one placeholder per event, so the
  same picture is currently repeated three times — it will look repetitive
  until three real photos per event replace it. Fill in `images` and drop the
  placeholder files when they land.
*/
import classicPlaceholder from '../../assets/images/events/mcgill-classic/classic-placeholder.jpg';
import evmPlaceholder from '../../assets/images/events/eng-vs-management/evm-placeholder.jpg';

/*
  The showcase photos are numbered runs of six, so they are pulled in by glob
  rather than named one by one. `eager` matters: it hands back the resolved
  `ImageMetadata` at build time, which is what `<Image>` needs — a lazy glob
  would only give back a loader function.
*/
const eventPhotos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/events/**/*.webp',
  { eager: true },
);
const photos = (folder: string, stem: string) =>
  [1, 2, 3, 4, 5, 6].map(
    (i) => eventPhotos[`/src/assets/images/events/${folder}/${stem}-${i}.webp`].default,
  );

/*
  Our two flagship events, in the order they lead the page.

  TODO: both detail pages are still bare placeholders — they say "Details
  coming soon" and nothing else — but the cards link through to them all the
  same. Setting `comingSoon: true` on an event puts a handwritten note on its
  card in place of the button and stops sending anyone there, if the empty page
  turns out to be the worse of the two.

  TODO: `turnout` and `target` are the projections we quote to sponsors — keep
  them in step with the figures on each event's own page once those pages are
  written. They are written under the second and third photo on the card, so
  keep them short: the caption strip holds one line.

  `shortTitle` is what goes under the first photo, for a name too long to sit
  on one line. Leave it off where `title` already fits.
*/
const capstones = [
  {
    title: 'The McGill Classic',
    blurb:
      'Our biggest tournament of the year, bringing teams from across campus together for one day of sport.',
    images: [classicPlaceholder, classicPlaceholder, classicPlaceholder],
    alt: 'The McGill Classic',
    turnout: '800 viewers',
    target: '$25,000',
    href: '/events/mcgill-classic/',
  },
  {
    title: 'Engineering vs. Management',
    blurb:
      'The annual faculty showdown — Engineering and Management go head to head to raise money for cancer research.',
    images: [evmPlaceholder, evmPlaceholder, evmPlaceholder],
    alt: 'Engineering vs. Management',
    shortTitle: 'Eng vs. Management',
    turnout: '800 viewers',
    target: '$25,000',
    href: '/events/eng-vs-management/',
    flip: true,
  },
];

/*
  `id` is the anchor the landing page's "glimpse into our events" polaroids
  link to, so keep them in step with the hrefs in index.astro.

  `captions` are the handwritten lines under each polaroid, in the same order
  as `images`. Swap these for the real event dates ("March 24th, 2026") — the
  frame is sized for a short single line.

  `highlight` is the phrase in the title the yellow marker swipe runs under.
  It has to appear in `title` word for word, and stay short enough to hold one
  line — a phrase that wraps gets the swipe under its last line only.
*/
const showcases = [
  {
    id: 'bar-night',
    title: 'Live music at Ye Olde Orchard',
    highlight: 'Live music',
    blurb: 'Our bar night brings the McGill community together for a night of live music.',
    alt: 'Bar night at Ye Olde Orchard',
    captions: ['Bar night', 'Ye Olde Orchard', 'Live music', 'The band', 'Full house', 'Last call'],
    images: photos('bar-night', 'bar-night'),
  },
  {
    id: 'dodgeball-tournament',
    title: '10-team dodgeball tournament',
    highlight: 'dodgeball',
    blurb: 'Ten teams, one bracket, and a full day of dodgeball raising money for the CCS.',
    alt: 'Dodgeball tournament',
    captions: ['Dodgeball', 'Ten teams', 'Warm-ups', 'Bracket day', 'Semi-final', 'The final'],
    images: photos('dodgeball-tournament', 'dodgeball'),
    flip: true,
  },
  {
    id: '3v3-tournament',
    title: 'A 3v3 March Madness basketball tournament',
    highlight: 'March Madness',
    blurb: 'Our March Madness bracket runs 3v3 games straight through to the final.',
    alt: '3v3 basketball tournament',
    captions: ['March Madness', '3v3 bracket', 'Tip-off', 'Game day', 'Semi-final', 'Championship'],
    images: photos('3v3-tournament', '3v3'),
  },
];
---

<Layout
  title="Events | McGill Cures Cancer"
  description="Our two capstone events — the McGill Classic and Engineering vs. Management — plus the tournaments and bar nights McGill Cures Cancer ran last year."
>
  <!-- Page title. It sits on the weave rather than on a card of its own: the
       first thing on the page should be a capstone event, not a header panel.
       Nothing labels the two runs of cards — the capstones say "Capstone
       event" on their face, and the piles of white polaroids below read as the
       archive by contrast. -->
  <header class="section-shell pt-10 pb-2 text-center">
    <h1 class="text-4xl font-extrabold tracking-tight text-slate-900">
      <span class="hand-underline">Our events</span>
    </h1>
  </header>

  <!-- 1. Capstone events. Same shape as the showcases below — a card per
       event, a pen mark in the gap — so the page reads as one run of paper
       rather than two. The gold frames are what set these two apart. -->
  {capstones.map((capstone, i) => (
    <>
      {/* A pen mark in the gap between the cards. Decorative only — see
          Doodle.astro. No mark above the first card: the page title is
          already in that gap. */}
      {i > 0 && <Doodle variant="triple" />}
      <CapstoneCard {...capstone} />
    </>
  ))}

  <!-- 2. Past events. The wave is the only break between the capstone run and
       the archive, so it stays even though the headings are gone. -->
  <Doodle variant="wave" />

  {showcases.map((showcase, i) => (
    <>
      {i > 0 && <Doodle variant={i % 2 ? 'loop' : 'triple'} />}
      <EventShowcase {...showcase} />
    </>
  ))}

  <Doodle variant="wave" />

  <SponsorWall heading="We couldn't put these events together without our sponsors" />
</Layout>

