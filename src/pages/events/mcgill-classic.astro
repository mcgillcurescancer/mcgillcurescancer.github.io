---
/*
  The McGill Classic, read top to bottom:

  1. The first card .. name, tagline, when, the way in for a sponsor, the two
                       figures, three polaroids, and what the day is made of
                       — hockey, food and drinks, music (EventPage.astro)
  2. Sponsor ......... (#sponsor) the partnership package itself

  The package is shown exactly as exported from Canva, one image per page, in
  src/assets/images/sponsorship/package-{1..7}.webp. When the package changes,
  export it again and replace those files — don't retype it here. Each page's
  `alt` carries its text for anyone who can't see the image, so update those
  alongside.
*/
import { Image } from 'astro:assets';
import EventPage from '../../layouts/EventPage.astro';
import Icon from '../../components/Icon.astro';

import onTheIce from '../../assets/images/events/mcgill-classic/mcgill-classic-3.webp';
import lacingUp from '../../assets/images/events/mcgill-classic/mcgill-classic-1.webp';
import theCrowd from '../../assets/images/events/mcgill-classic/mcgill-classic-2.webp';

import page1 from '../../assets/images/sponsorship/package-1.webp';
import page2 from '../../assets/images/sponsorship/package-2.webp';
import page3 from '../../assets/images/sponsorship/package-3.webp';
import page4 from '../../assets/images/sponsorship/package-4.webp';
import page5 from '../../assets/images/sponsorship/package-5.webp';
import page6 from '../../assets/images/sponsorship/package-6.webp';
import page7 from '../../assets/images/sponsorship/package-7.webp';

const EMAIL = 'mcgillcurescancer@ssmu.ca';
const sponsorMailto = `mailto:${EMAIL}?subject=${encodeURIComponent('Sponsoring the McGill Classic')}`;

const photos = [
  { src: onTheIce, alt: 'A 3v3 game on the outdoor rink at the McGill Classic', caption: 'On the ice' },
  { src: lacingUp, alt: '', caption: 'Lacing up' },
  { src: theCrowd, alt: '', caption: 'The crowd' },
];

/* The key facts under the tagline, as small pills. */
const facts = ['February 2027', 'Venue to be announced', '3v3 hockey', 'Food, drinks & music'];

const highlights = [
  {
    icon: 'sticks',
    title: 'On the ice',
    text: 'Three-on-three hockey: open ice, quick shifts and plenty of goals, with teams from every corner of McGill.',
    tone: 'bg-mcc-50 text-mcc-700 ring-mcc-100',
  },
  {
    icon: 'cup',
    title: 'Food and drinks',
    text: 'Something warm to eat and drink rinkside, for players between games and fans in the stands.',
    tone: 'bg-amber-50 text-amber-700 ring-amber-200',
  },
  {
    icon: 'music',
    title: 'Music',
    text: 'Music playing all day, from the first puck drop to the final.',
    tone: 'bg-stone-100 text-stone-700 ring-stone-200',
  },
] as const;

const packagePages = [
  { src: page1, alt: 'Partnership Package — McGill Classic. Cover.' },
  {
    src: page2,
    alt: 'What is MCC? McGill Cures Cancer (MCC) is a 100% student-run, non-profit organization that brings together the McGill community through sporting events in an effort to fundraise money towards cancer research. As the official chapter of the Canadian Cancer Society’s Rivalry program, MCC engages the community through fundraising initiatives and events that inspire positive change and unite people around a common cause. MCC was founded in Fall 2025, driven by a shared commitment to making a meaningful impact. Each with a personal story connected to cancer, our executive team understands the impact cancer can have on the lives of those affected, and are therefore personally motivated to make a big impact. @mcgillcurescancer, mcgillcurescancer@ssmu.ca.',
  },
  {
    src: page3,
    alt: 'Why sponsor? McGill Cures Cancer is committed to building meaningful, mutually beneficial partnerships with our sponsors. Your support helps maximize our donation to the Canadian Cancer Society while enhancing the experience for the students, athletes, and fans who make our events possible. Our annual hockey tournament, the McGill Classic, offers sponsors valuable brand exposure across the McGill and Montreal communities, while creating opportunities to engage directly with talented students from every faculty. In February 2027, McGill will host its second annual rivalry hockey tournament. We invite you to join us in bringing the community together through sport to support the more than 220,000 Canadians diagnosed with cancer each year. Every partnership helps create a memorable event while making a meaningful impact in the fight against cancer.',
  },
  {
    src: page4,
    alt: 'McGill Classic Partnerships, February 2027. $5,000 – Title Sponsor: Sponsor the McGill Classic, receiving recognition in all promotional platforms. “The McGill Classic presented by COMPANY NAME”. Contribution open to discussion. Benefits: name and logo on promotional materials (tickets, posters, digital assets, player jerseys); free admission for company representatives; social media feature across channels; logo displayed at event. $2,000 Jersey Sponsor: As our Jersey Sponsor, you cover the cost of the customized game jerseys, or supply them directly. Benefits: the only company logo on the front of both teams’ game jerseys; your logo in every game photo, highlight video and post-game post; a dedicated Instagram post revealing the jerseys before the game; logo on posters and the sponsor banner at the event.',
  },
  {
    src: page5,
    alt: 'McGill Classic Partnerships, February 2027. In Kind Prize Sponsor: In-kind sponsors donate prizes for the winning team, MVP and raffle winners, or food and drinks for players and fans. Benefits: social media feature across channels; logo displayed at event; shoutout after the game.',
  },
  {
    src: page6,
    alt: 'Past sponsors: Prince Arthur Orchard, Celsius, Enso Yoga, Chef On Call, Easy Mondays, Batiste, Café Campus, Red Bull, Shape and Poppi.',
  },
  {
    src: page7,
    alt: 'Contact. On behalf of the entire McGill Cures Cancer Executive Team, we thank you for your interest in our mission and invite you to play a significant role in the success of this year. We look forward to discussing the implementation of a mutually beneficial partnership that would maximize the value to your organization, as well as maximize our donation to the Canadian Cancer Society. Maahir Paliwal, Co-Chair, maahir.paliwal@mail.mcgill.ca. Esmé Chapman, Co-Chair, esme.korchinsky@mail.mcgill.ca. McGill Cures Cancer, mcgillcurescancer@ssmu.ca.',
  },
];
---

<EventPage
  title="The McGill Classic"
  description="The McGill Classic is McGill Cures Cancer's 3v3 hockey tournament, with food, drinks and music, and every dollar raised going to cancer research. Partnership package inside."
  tagline="A 3v3 hockey tournament with food, drinks and music — and every dollar it raises goes to cancer research."
  photos={photos}
  logo="/assets/images/logos/mcgill-classic/mcgill-classic-logo.webp"
  expectedTurnout="800 viewers"
  fundraisingGoal="$25,000"
>
  <Fragment slot="hero">
    <ul class="mt-5 flex flex-wrap gap-2 text-sm font-medium text-slate-600">
      {facts.map((fact) => (
        <li class="rounded-full border border-stone-200 bg-stone-50 px-3 py-1">{fact}</li>
      ))}
    </ul>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#sponsor"
         class="rounded-lg bg-mcc-600 px-5 py-3 text-sm font-semibold text-white shadow-lg hover:bg-mcc-700">
        Sponsor the Classic
      </a>
      <a href={`mailto:${EMAIL}`}
         class="rounded-lg border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 hover:bg-stone-50">
        Email the team
      </a>
    </div>
  </Fragment>

  <!-- What the day is made of, on the first card's paper below a pen rule. -->
  <div slot="highlights" class="mt-14 border-t border-dashed border-stone-300 pt-10">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900">
      More than a <span class="hand-underline">hockey game</span>
    </h2>
    <p class="mt-3 text-lg text-slate-600">
      The Classic is a day out for the whole campus, whether you are on a team or
      cheering from the boards.
    </p>
    <ul class="mt-8 grid gap-6 sm:grid-cols-3">
      {highlights.map((item) => (
        <li class="flex gap-4">
          <span class:list={['flex h-12 w-12 flex-none items-center justify-center rounded-full ring-1', item.tone]}>
            <Icon name={item.icon} class="h-6 w-6" />
          </span>
          <div>
            <h3 class="font-bold text-slate-900">{item.title}</h3>
            <p class="mt-1 text-sm text-slate-600">{item.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>

  <!-- 2. The partnership package, page by page — the target for the hero's
       "Sponsor the Classic" button. Two pages to a row from `md` up, so it
       reads like a printed spread; each one opens full size on its own. -->
  <section id="sponsor" class="section-shell scroll-mt-24 pb-16">
    <div class="section-card">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900">
          Partnership <span class="hand-underline">package</span>
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">
          Tap any page to open it full size.
        </p>
      </div>

      <ol class="mt-10 grid gap-6 md:grid-cols-2">
        {packagePages.map((page, i) => (
          /* An odd page out at the end sits centred under the last spread
             rather than hanging off the left. */
          <li class:list={[
            i === packagePages.length - 1 && i % 2 === 0 && 'md:col-span-2 md:mx-auto md:w-[calc(50%-0.75rem)]',
          ]}>
            <a href={page.src.src} target="_blank" rel="noopener"
               class="block overflow-hidden rounded-xl shadow-md ring-1 ring-stone-200 transition-shadow hover:shadow-lg focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-mcc-700">
              <Image src={page.src} alt={page.alt}
                     widths={[600, 900, 1200, 1545]} width={1545}
                     sizes="(min-width: 1152px) 512px, (min-width: 768px) calc((100vw - 152px) / 2), calc(100vw - 80px)"
                     class="h-auto w-full" />
              <span class="sr-only">Page {i + 1} of {packagePages.length}, opens full size</span>
            </a>
          </li>
        ))}
      </ol>

      <div class="mt-12 flex flex-wrap justify-center gap-3">
        <a href={sponsorMailto}
           class="rounded-lg bg-mcc-600 px-5 py-3 text-sm font-semibold text-white shadow-lg hover:bg-mcc-700">
          Email us about sponsoring
        </a>
        <a href="https://www.instagram.com/mcgillcurescancer/" rel="noopener" target="_blank"
           class="rounded-lg border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 hover:bg-stone-50">
          Message us on Instagram
        </a>
      </div>
    </div>
  </section>
</EventPage>
